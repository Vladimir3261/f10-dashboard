# The Pi's control panel. Installed by install.sh, which substitutes
# @PI_USER@ and @REPO_DIR@.
#
# Independent of f10-dashboard on purpose: this is what you reach for
# WHEN the runtime is broken, so it must not share its fate. It also
# restarts that unit, which it could not do from inside it.
[Unit]
Description=F10 Pi admin panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@PI_USER@
WorkingDirectory=@REPO_DIR@/hardware/raspberry-pi/admin
ExecStart=/usr/bin/python3 @REPO_DIR@/hardware/raspberry-pi/admin/server.py \
    --config @REPO_DIR@/hardware/raspberry-pi/admin/config.json
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# The panel reads system state and shells out to a short allowlist.
# Everything is read-only except the checkout itself, which it must be
# able to write: `pull` updates the worktree and .git, and session-file
# housekeeping deletes databases under local/. ReadWritePaths overrides
# both ProtectSystem and ProtectHome for the paths it names, which is
# what makes a repo under /home writable while the rest of /home is not.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPO_DIR@
# NOT PrivateTmp. tmux's server socket lives in /tmp/tmux-<uid>/, so a
# private /tmp would make the Claude session invisible to this panel -
# `tmux has-session` and `capture-pane` would both fail, and the pane is
# the only place a crash-loop's cause is ever printed.
NoNewPrivileges=no
# ^ sudo needs this off. The privilege it can gain is bounded by
#   /etc/sudoers.d/f10-admin, which names each command in full.

[Install]
WantedBy=multi-user.target

# Wi-Fi networks — copy to config/wifi.env (gitignored) and edit.
# Real SSIDs and PSKs must NEVER be committed. NetworkManager connects to
# the highest-priority available known network automatically.
#
# Define up to N networks as WIFI_<n>_{SSID,PSK,PRIORITY}. Higher priority
# wins when more than one is in range. configure-wifi.sh reads these.

# 1) in-vehicle LTE router — highest, so it is chosen at every boot in the
#    car. It also wins when parked at home, which means mobile data there;
#    drop it below the home network if you would rather avoid that.
WIFI_1_SSID=<VEHICLE_LTE_SSID>
WIFI_1_PSK=<VEHICLE_LTE_PSK>
WIFI_1_PRIORITY=110

# 2) home Wi-Fi
WIFI_2_SSID=<HOME_WIFI_SSID>
WIFI_2_PSK=<HOME_WIFI_PSK>
WIFI_2_PRIORITY=100

# 3) phone / mobile hotspot — the fallback
WIFI_3_SSID=<MOBILE_HOTSPOT_SSID>
WIFI_3_PSK=<MOBILE_HOTSPOT_PSK>
WIFI_3_PRIORITY=70

# Number of networks defined above
WIFI_COUNT=3

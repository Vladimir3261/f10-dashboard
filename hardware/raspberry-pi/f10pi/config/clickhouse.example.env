# ClickHouse access for the sync agent — copy to config/clickhouse.env
# (gitignored) and edit. The Pi reaches ClickHouse over the WireGuard
# management IP, never a public address. INSERT-only user.
#
# NEVER commit real hosts, users, or passwords.

# Reach ClickHouse/ingest over wg0 (private management IP), not the public IP.
CLICKHOUSE_HOST=<WG_SERVER_IP>        # e.g. 10.77.0.1
CLICKHOUSE_PORT=8123

# Ingest credentials — INSERT-only role for the Pi.
CLICKHOUSE_USER=telemetry_ingest
CLICKHOUSE_PASSWORD=<CLICKHOUSE_INGEST_PASSWORD>

# The ingest endpoint token (matches infra/.env INGEST_TOKEN on the server).
INGEST_URL=http://<WG_SERVER_IP>:<INGEST_PORT>/ingest
INGEST_TOKEN=<INGEST_TOKEN>

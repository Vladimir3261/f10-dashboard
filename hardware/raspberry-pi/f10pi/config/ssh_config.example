# Pi -> telemetry server SSH client config.
# Copy to config/ssh_config (gitignored) and edit, then configure-ssh.sh
# installs it into ~/.ssh/config.d/ (or appends to ~/.ssh/config).
#
# Use a dedicated key for the Pi->server hop and reference the server by a
# generic alias, not its real hostname/IP. Reach the server over the
# WireGuard management IP, never its public IP.

Host telemetry-server
    HostName <WG_SERVER_IP>          # e.g. 10.77.0.1 (over wg0)
    User <SERVER_USER>
    IdentityFile ~/.ssh/id_ed25519_f10pi
    IdentitiesOnly yes
    # Avoids "Too many authentication failures" when the agent offers
    # several keys: only try the one named above.
    PubkeyAuthentication yes
    PreferredAuthentications publickey

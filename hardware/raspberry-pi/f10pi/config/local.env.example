# f10pi local config — copy to config/local.env (gitignored) and edit.
# Sourced by scripts/bootstrap.sh and the configure-* scripts.
# Contains NO secrets itself; points at the other config files that do.

# Device identity (mDNS name; keep generic, no location/personal info)
PI_HOSTNAME=f10pi

# Login user on the Pi (the OS-created account). "pi" is the Raspberry Pi
# OS default; change it if you created a different account when flashing.
# NOTE: unrelated to `admin_user` on the analytics server.
PI_USER=pi

# Where the project repo is checked out on the Pi
REPO_DIR=/home/${PI_USER}/f10-dashboard

# The server's address on the VPN. The sync agent and any manual admin use
# this; it is also what verify.sh pings to prove the tunnel is up.
WG_SERVER_IP=10.77.0.1

# Network interface names (Pi 4 defaults)
WLAN_IF=wlan0
ETH_IF=eth0
WG_IF=wg0

# Wi-Fi regulatory country. REQUIRED: set the ISO 3166-1 alpha-2 code for the
# physical installation country before running bootstrap (for example DE, GB,
# PL, US). It is applied before NetworkManager's first scan so legal channels
# such as 2.4 GHz 12/13 are available during cold boot where applicable.
WIFI_COUNTRY=

# Raspberry Pi 4 / BCM43455 workaround. When enabled, provisioning replaces
# only the known-bad 7.45.265 firmware with SHA-256-pinned Infineon 7.45.286
# plus the matching CLM blob. Unknown/newer firmware is never overwritten.
PATCH_BRCM43455_FIRMWARE=1

# BMW ENET link-local config for eth0. The Pi self-assigns a 169.254.x.x
# address; a fixed one keeps things predictable. eth0 must NEVER hold the
# default route (enforced by configure-eth0-bmw.sh).
ETH_LINK_LOCAL=169.254.10.10/16

# Feature toggles for bootstrap.sh (1 = do it, 0 = skip)
DO_HOSTNAME=1
DO_WIFI_REGULATORY=1
DO_WIFI=1
DO_WIREGUARD=1
DO_SSH=1
DO_ETH0_BMW=1
DO_APP_SERVICES=1

# SSH hardening: only set to 1 AFTER key auth is confirmed working, or you
# can lock yourself out. Leave 0 for first provisioning.
SSH_DISABLE_PASSWORD_AUTH=0

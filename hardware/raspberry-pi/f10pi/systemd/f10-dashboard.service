# f10 telemetry runtime + dashboard. Installed by configure-app-services.sh,
# which substitutes @PI_USER@ and @REPO_DIR@ from config/local.env.
# Read-only on the car. Waits for the network but does NOT require the BMW
# cable (the runtime tolerates the car being absent and retries).
[Unit]
Description=F10 telemetry runtime + dashboard (run_car.sh)
After=network-online.target
Wants=network-online.target
# The Pi has no RTC: it boots with whatever fake-hwclock saved at the
# last shutdown. Starting before NTP has landed means recording against
# a stale clock and having it corrected mid-drive - which on 2026-08-29
# stretched a session's timeline by 76 minutes.
#
# `Wants`, not `Requires`: a car parked out of network range must still
# record. The runtime waits briefly on its own (--wait-for-clock) and
# labels every run with whether the clock was trustworthy, so a run
# taken offline is honest rather than absent.
After=time-sync.target
Wants=time-sync.target

[Service]
Type=simple
User=@PI_USER@
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/run_car.sh
Restart=on-failure
RestartSec=5
# stdlib-only runtime: no venv, just system python3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

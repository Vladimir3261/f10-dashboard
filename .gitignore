# ---------------------------------------------------------------- local
#
# Everything that is not the application: scratch scripts, captures,
# analysis notes and exported data. See local/README.md.
#
/local/

# ------------------------------------------------------ vehicle data
#
# Telemetry databases are recorded per drive. They are large, they are
# regenerated on every run, and they carry the VIN of whichever car
# produced them - none of that belongs in version control.
#
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Exported telemetry, wherever it is written from
telemetry_export.json
telemetry_json/

# Unredacted on-car validation artifacts - these carry the VIN read from
# the gateway. The VIN-redacted copies under validation-runs/ ARE tracked.
/local/validation-runs-raw/

# ------------------------------------------------------------- python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
ENV/
.python-version

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------- IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------------ OS
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ------------------------------------------------------------ infra secrets
# Deployment secrets and local sync config/state — never committed.
/infra/.env
/infra/sync/config.json
/local/sync-state.json

# ------------------------------------------------------------ infra IaC
# Terraform state can contain secrets; tfvars holds your own values; the
# generated Ansible inventory holds the droplet's public IP. Only the
# tracked *.example / *.tf templates belong in git.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infra/terraform/crash.log
infra/terraform/override.tf
infra/terraform/override.tf.json
infra/ansible/inventory/hosts.yml
!infra/ansible/inventory/hosts.yml.example
infra/ansible/*.retry

# --------------------------------------------------------- hardware secrets
# Per-device config + secrets for the Pi and other hardware. Only the
# tracked *.example / *.template files belong in git; the real files
# (Wi-Fi PSKs, WireGuard keys, backend creds) are injected outside git.
hardware/**/config/local.env
hardware/**/config/secrets.env
hardware/**/config/wifi.env
hardware/**/config/wireguard.conf
hardware/**/config/clickhouse.env
hardware/**/config/ssh_config
hardware/**/*.key
hardware/**/*.pem
hardware/**/*_wg0.conf

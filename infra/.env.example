# Copy to infra/.env and fill in. .env is gitignored - never commit real
# secrets. Two consumers read this one file:
#   * the infra Makefile loads + exports it (provisioning, runs locally)
#   * docker-compose reads it on the VPS (running the stack)
# So it holds every infra secret in one place.
#
# NOTE: the Makefile parses this with make's KEY=value rules, so avoid '#'
# and leading/trailing spaces inside a value (a '#' starts a comment and
# truncates the value). The generators suggested below (openssl rand -hex)
# only emit hex, so they are always safe.

# --- provisioning (used locally by terraform via the Makefile) -------------

# DigitalOcean API token for `make apply` / terraform. Create one at
# https://cloud.digitalocean.com/account/api/tokens (read+write). The
# Makefile exports this so terraform picks it up automatically.
DIGITALOCEAN_TOKEN=dop_v1_change-me

# --- the stack (used by docker-compose on the VPS) -------------------------

# ClickHouse credentials (the ingest server uses these internally;
# ClickHouse itself is not exposed to the host).
CH_USER=default
CH_PASS=change-me-clickhouse

# Shared bearer token the sync agent must present. Generate a long random
# value, e.g.:  openssl rand -hex 32
INGEST_TOKEN=change-me-long-random-token

# Which address the ingest port is published on.
#
# This MUST be an address the Raspberry Pi can reach, and the Pi reaches the
# server over WireGuard - so it is the server's VPN address, not 127.0.0.1.
# Bound to loopback the port is unreachable from the tunnel and the sync
# agent just times out ("state: offline", sent_rows: 0) with no clue why.
#
# Do NOT set 0.0.0.0: Docker publishes ports with its own iptables rules that
# sit AHEAD of ufw, so the port would be exposed to the internet regardless of
# the host firewall. Binding to the VPN address means only tunnel peers can
# reach it, with no reliance on a firewall rule at all.
INGEST_BIND=10.77.0.1

# Grafana admin password (user: admin). Generate: openssl rand -hex 16
GF_ADMIN_PASSWORD=change-me-grafana-admin

# Where the Grafana CONTAINER publishes. Keep 127.0.0.1: the container is
# never exposed directly. Public access goes through the host nginx proxy
# below, which is what the IP allowlist protects. (Publishing the container
# on 0.0.0.0 would bypass ufw entirely - Docker inserts its own iptables
# rules ahead of it - so don't.)
GF_BIND=127.0.0.1

# --- public Grafana access (host nginx reverse proxy) ---------------------

# Comma-separated IPs/CIDRs allowed to reach Grafana from the internet.
# A bare IP means that single address; add /24 etc. for a range.
# EMPTY MEANS NOBODY - nginx denies all, which is the safe default.
# Both the DigitalOcean firewall and nginx are configured from this value.
#   e.g. GF_ALLOWED_IPS=203.0.113.4,198.51.100.0/24
GF_ALLOWED_IPS=

# Port nginx listens on for Grafana.
# NOTE: port 80 is plain HTTP - your Grafana login password crosses the
# internet in cleartext. The IP allowlist limits WHO can connect, not
# whether traffic is readable in transit. Put TLS in front before relying
# on this over untrusted networks.
GF_PUBLIC_PORT=80

# server_name for the nginx vhost. `_` matches any host (fine for
# access by bare IP); set a domain if you have one.
GF_SERVER_NAME=_

# --- OPTIONAL: domains + Let's Encrypt TLS -------------------------------
#
# Leave GRAFANA_DOMAIN and DASHBOARD_DOMAIN empty to skip all of this - the
# setup then works exactly as above (plain HTTP on GF_PUBLIC_PORT, or just
# the SSH tunnel). Set them to serve real HTTPS instead.
#
# PREREQUISITE: each name must already have a DNS A record pointing at the
# droplet before you deploy. Ansible verifies this and refuses to run
# certbot otherwise, because a wrong record just produces a cryptic failure
# (and repeated attempts hit Let's Encrypt rate limits).

# Grafana over HTTPS. Access is still restricted to GF_ALLOWED_IPS above.
GRAFANA_DOMAIN=

# The in-car Raspberry Pi dashboard, reverse-proxied over the WireGuard
# tunnel (the Pi has no public IP). Protected by HTTP Basic Auth, since it
# needs to be reachable from a phone on mobile data where an IP allowlist
# cannot work.
DASHBOARD_DOMAIN=

# Where the Pi answers on the VPN. Must match the peer address you give it
# in ansible/group_vars/all.yml (wireguard_peers).
PI_WG_IP=10.77.0.10
PI_DASHBOARD_PORT=8080

# Basic Auth for the dashboard vhost. REQUIRED when DASHBOARD_DOMAIN is set
# - the dashboard has no login of its own and serves the VIN.
DASHBOARD_AUTH_USER=f10
DASHBOARD_AUTH_PASSWORD=change-me-dashboard-password

# Contact address for Let's Encrypt (expiry notices). Required when either
# domain is set.
LETSENCRYPT_EMAIL=

# Use the Let's Encrypt STAGING environment (untrusted certs, but very high
# rate limits). Set to 1 while testing so a misconfiguration cannot burn
# your 5-per-week production quota; set back to 0 for real certificates.
LETSENCRYPT_STAGING=0

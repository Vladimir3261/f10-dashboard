# Copy to infra/.env and fill in. docker-compose reads this file.
# .env is gitignored - never commit real secrets.

# ClickHouse credentials (the ingest server uses these internally;
# ClickHouse itself is not exposed to the host).
CH_USER=default
CH_PASS=change-me-clickhouse

# Shared bearer token the sync agent must present. Generate a long random
# value, e.g.:  openssl rand -hex 32
INGEST_TOKEN=change-me-long-random-token

# Where to publish the ingest port. Keep 127.0.0.1 and terminate TLS with
# a reverse proxy in front; use 0.0.0.0 only if the proxy is elsewhere.
INGEST_BIND=127.0.0.1

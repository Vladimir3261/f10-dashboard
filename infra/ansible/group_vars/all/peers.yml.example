---
# Example. The REAL group_vars/all/peers.yml is generated by
# `make pi-setup` and is gitignored: it holds device public keys, which
# identify your hardware even though they are not secrets.
#
# Ansible loads every file in group_vars/all/ alphabetically, and `peers`
# sorts after `main`, so this file's wireguard_peers wins over the empty
# default in main.yml.
wireguard_peers:
  - name: f10pi
    public_key: "<the Pi's WireGuard public key>"
    allowed_ips: "10.77.0.10/32"

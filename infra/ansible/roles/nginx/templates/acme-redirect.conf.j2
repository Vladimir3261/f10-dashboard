# Managed by Ansible (nginx role) - do not edit on the server.
#
# Port 80 must be reachable from ANY address, because Let's Encrypt
# validates the HTTP-01 challenge from many global IPs. So this vhost is
# deliberately open, but it serves ONLY the challenge path - everything else
# is redirected to HTTPS. All real access control (IP allowlist, Basic Auth)
# lives on the 443 vhosts.

#
# This vhost claims ONLY the TLS domains. It becomes the port-80
# default_server just when Grafana has its own domain - because then no
# plain-HTTP vhost exists. If Grafana is still served by IP, that vhost is
# the default instead, so reaching the droplet by address keeps working
# rather than being redirected to an HTTPS name it has no certificate for.

server {
    listen 80{% if grafana_domain %} default_server{% endif %};

    listen [::]:80{% if grafana_domain %} default_server{% endif %};

    server_name {{ tls_domains | join(' ') }};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Managed by Ansible (nginx role) - do not edit on the server.
#
# Public edge for the in-car Raspberry Pi dashboard. The Pi has no public
# address: it reaches this server outbound over WireGuard, and nginx proxies
# back to it across that tunnel. No reverse SSH tunnel is needed - the VPN
# already provides the path.
#
# Protected by HTTP Basic Auth rather than an IP allowlist, because the
# point is to view it from a phone on mobile data, where the client IP
# changes constantly. The dashboard has no login of its own and serves the
# VIN, so this vhost is never configured without credentials.
#
# The one exception is the /s/ prefix: temporary share links. Basic Auth is
# off there so a link can be handed to someone without giving them the
# password, and live.py is the authority instead - it validates the token,
# serves only the live view, masks the VIN unconditionally, and refuses the
# history and sync endpoints. nginx never sees the tokens and needs no
# reload when one is minted or revoked.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ dashboard_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ dashboard_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ dashboard_domain }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    auth_basic           "F10 dashboard";
    auth_basic_user_file /etc/nginx/.htpasswd-dashboard;

    # The car is not always online: fail fast rather than hanging when the Pi
    # is parked, off, or out of signal...
    proxy_connect_timeout 5s;

    # ...and show a page that explains it instead of nginx's bare 502.
    # Reachable by share viewers too when the car is offline, which is why
    # it names no addresses, keys or vehicle identifiers.
    error_page 502 503 504 /__offline.html;
    location = /__offline.html {
        root /var/www/f10-offline;
        internal;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://{{ pi_wg_ip }}:{{ pi_dashboard_port }};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 120s;
    }

    # The dashboard streams telemetry over Server-Sent Events; buffering
    # would make the live view lag badly or appear frozen.
    # -- temporary share links ------------------------------------------
    #
    # No auth_basic here: the bearer token in the URL is the credential, and
    # live.py enforces it. Anything not on its allowlist 404s at the Pi.
    location /s/ {
        auth_basic off;

        proxy_pass http://{{ pi_wg_ip }}:{{ pi_dashboard_port }};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 120s;

        # A shared link is not something to leave in a search index.
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # The shared view streams over SSE as well, and needs the same
    # buffering-off treatment as the owner's stream below.
    location /s/api/stream {
        auth_basic off;

        proxy_pass http://{{ pi_wg_ip }}:{{ pi_dashboard_port }};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_buffering     off;
        proxy_cache         off;
        proxy_read_timeout  1h;
        chunked_transfer_encoding off;

        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location /api/stream {
        proxy_pass http://{{ pi_wg_ip }}:{{ pi_dashboard_port }};
        proxy_http_version 1.1;

        proxy_set_header Host       $host;
        proxy_set_header Connection "";

        proxy_buffering     off;
        proxy_cache         off;
        proxy_read_timeout  1h;
        chunked_transfer_encoding off;
    }
}

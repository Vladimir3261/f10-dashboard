    "throttle": "engine.throttle_valve",
    "speed": "vehicle.speed",
    "maf": "engine.maf",
    "rail": "fuel.rail_pressure.actual",
    "torque": "engine.torque",
    "pedal": "engine.accelerator_pedal",
    "relthr": "engine.throttle_relative",
    "lambda": "engine.lambda",
    "oil": "engine.oil_temperature",
    "iat": "engine.intake_air_temperature",
    "ambient": "ambient.temperature",
    "cattemp": "exhaust.catalyst_temperature",
    "egr": "egr.commanded",
    "egrerr": "egr.error",
    "voltage": "electrical.voltage",
    "baro": "ambient.pressure",
    "fuel": "fuel.level",
    "fuel_l": "fuel.remaining",
    "fuelrate": "fuel.rate",
    "runtime": "engine.runtime",
    "distance": "engine.distance_since_clear",

    "n47d_oil_temp": "engine.oil_temperature",
    "n47d_coolant": "engine.coolant_temperature",

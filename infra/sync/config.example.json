{
  "_comment": "Copy to infra/sync/config.json (gitignored) and edit. Every field can also be overridden by an env var SYNC_<UPPERCASE_KEY>.",

  "server_url": "https://telemetry.example.com",
  "token": "the-same-long-random-token-as-INGEST_TOKEN",

  "databases": [
    "telemetry.db",
    "local/sessions/*.db"

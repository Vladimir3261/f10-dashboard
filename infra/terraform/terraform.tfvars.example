# Copy to terraform.tfvars (gitignored) and adjust. All values are optional
# - the defaults in variables.tf work - but you will usually set at least
# the region and your SSH key path.
#
# The API token is NOT set here. Export it instead so it never hits a file:
#   export DIGITALOCEAN_TOKEN=dop_v1_your_token

droplet_name = "f10-analytics"
region       = "fra1"                     # pick a region near you
droplet_size = "s-2vcpu-4gb"
droplet_image = "ubuntu-24-04-x64"

# Local PUBLIC key(s) to authorise on the droplet (and later the Pi).
ssh_public_key_files = ["~/.ssh/id_ed25519.pub"]

# Lock SSH down to your own address in production, e.g. ["203.0.113.4/32"].
ssh_allowed_cidrs = ["0.0.0.0/0", "::/0"]

wireguard_port = 51820
tags           = ["f10", "analytics"]
